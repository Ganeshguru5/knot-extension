{
  "manifest_version": 3,
  "name": "IamCandidate — Job & Referral Capture",
  "short_name": "IamCandidate",
  "version": "1.6.0",
  "description": "Save jobs and LinkedIn referrals to IamCandidate, and autofill application forms with your details and resume.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Save to IamCandidate (Alt+K)",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+K", "mac": "Alt+K" },
      "description": "Open IamCandidate on the current page"
    }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "side_panel": { "default_path": "src/panel/panel.html" },
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": ["https://ps4y8f4z9f.execute-api.ap-south-1.amazonaws.com/*"],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*", "http://*/*"]
}
