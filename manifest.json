{
  "manifest_version": 3,
  "name": "iamcandidate — Job & Referral Capture",
  "short_name": "iamcandidate",
  "version": "1.2.0",
  "description": "Save the job you're applying to and add referrals from LinkedIn profiles straight into your iamcandidate account.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Save to iamcandidate (Alt+K)",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+K", "mac": "Alt+K" },
      "description": "Open iamcandidate on the current page"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://ps4y8f4z9f.execute-api.ap-south-1.amazonaws.com/*"],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*"]
}
